<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="#E5E7EB"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMortalityTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/cuni_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="L-011" />

            <TextView
                android:id="@+id/tvMortalitySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#6B7280"
                android:textSize="13sp"
                tools:text="Mâle · Chinchilla · 4 mois · 9 oct. 2026" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMortalityCauseBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_green_container"
            android:backgroundTint="#FEF2F2"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="#B91C1C"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Maladie" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
