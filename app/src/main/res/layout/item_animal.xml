<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardAnimal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="#E0E0E0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- Left Circular Rabbit Avatar -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardBackgroundColor="#E8F5E9"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:contentDescription="Icone Lapin"
                android:src="@drawable/ic_pets"
                app:tint="@color/cuni_green_primary" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Center Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTagNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/cuni_text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="L-014" />

            <TextView
                android:id="@+id/tvSexAndBreed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#616161"
                android:textSize="13sp"
                tools:text="Femelle · Néo-Zélandais" />

            <TextView
                android:id="@+id/tvAgeAndWeight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#424242"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="8 mois · 3,8 kg" />
        </LinearLayout>

        <!-- Right Side: Category Badge & Chevron -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCategoryBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_reproducteur"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/cuni_green_primary_dark"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Reproducteur" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="8dp"
                android:contentDescription="Détails"
                android:src="@drawable/ic_chevron_right"
                app:tint="#9E9E9E" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
