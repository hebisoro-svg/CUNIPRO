<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cuni_background">

    <!-- Top Navigation Header -->
    <LinearLayout
        android:id="@+id/headerNotifications"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill_white"
            android:contentDescription="@string/btn_close"
            android:src="@drawable/ic_back"
            app:tint="@color/cuni_green_primary_dark" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/tasks_notifications"
            android:textColor="@color/cuni_green_primary_dark"
            android:textSize="22sp"
            android:textStyle="bold" />

        <include
            android:id="@+id/includeTopActions"
            layout="@layout/include_top_actions" />
    </LinearLayout>

    <!-- Segmented Tab Bar Container -->
    <LinearLayout
        android:id="@+id/containerTabs"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_pill_segmented"
        android:padding="4dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/headerNotifications"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnTabReceived"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/tasks_received_tab"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/cuni_text_primary"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnTabTasks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/title_tasks"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/bg_pill_selected"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Tab 1: Received Notifications Layout -->
    <LinearLayout
        android:id="@+id/layoutReceivedView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/containerTabs"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="gone">

        <!-- Subheader: Unread count & Mark all as read -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tvUnreadCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="3 non lues"
                android:textColor="@color/cuni_green_primary_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMarkAllRead"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/tasks_mark_all_read"
                android:textSize="12sp"
                android:textColor="@color/cuni_green_primary_dark"
                app:strokeColor="@color/cuni_green_primary_dark"
                app:strokeWidth="1dp"
                app:cornerRadius="18dp"
                android:paddingHorizontal="12dp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvNotifications"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp"
            tools:listitem="@layout/item_notification" />
    </LinearLayout>

    <!-- Tab 2: Tasks Layout -->
    <LinearLayout
        android:id="@+id/layoutTasksView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/containerTabs"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Description Card -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:text="@string/tasks_info_banner"
            android:textColor="#616161"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTasks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="80dp"
            tools:listitem="@layout/item_task" />
    </LinearLayout>

    <!-- Extended FAB "+ Nouvelle tâche" -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAddTask"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:text="@string/tasks_add_task"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/white"
        app:backgroundTint="#1B5E20"
        app:cornerRadius="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
