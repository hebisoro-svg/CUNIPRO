<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="#EAEAEA"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- Checkbox -->
        <CheckBox
            android:id="@+id/cbTaskCompleted"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:button="@null"
            android:drawableStart="?android:attr/listChoiceIndicatorMultiple" />

        <!-- Center Content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTaskTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Appeler l'acheteur (portée L-019)"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/cuni_text_primary" />

                <ImageView
                    android:id="@+id/ivFlagIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:src="@drawable/ic_flag"
                    android:visibility="gone"
                    android:contentDescription="Important"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTaskSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Vente prévue · 20 oct., 16:00"
                android:textSize="13sp"
                android:textColor="#616161"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvTaskReminder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="🔔 Rappel : le jour même"
                android:textSize="12sp"
                android:textColor="#757575"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Auto Badge -->
        <TextView
            android:id="@+id/tvAutoBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Auto"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:background="@drawable/bg_pill_green_container"
            android:textColor="@color/cuni_green_primary_dark"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
