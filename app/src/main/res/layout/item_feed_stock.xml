<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardFeedStock"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="#E0E0E0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Left Food Icon Circle -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFeedIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardBackgroundColor="#FFF8E1"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/ivFeedIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="Icone Aliment"
                android:src="@drawable/ic_restaurant"
                app:tint="#F57C00" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Center Name & Threshold -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFeedName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/cuni_text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="Granulés" />

            <TextView
                android:id="@+id/tvAlertThresholdInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#757575"
                android:textSize="13sp"
                tools:text="Seuil d'alerte : 25 kg" />

            <TextView
                android:id="@+id/tvStockStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_badge_engraissement"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:textColor="#E65100"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Stock faible" />
        </LinearLayout>

        <!-- Right Quantity -->
        <TextView
            android:id="@+id/tvQuantityKg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/cuni_text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="18 kg" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
