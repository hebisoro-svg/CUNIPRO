<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme for Night mode -->
    <style name="Base.Theme.CUNIPRO" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary Brand Colors -->
        <item name="colorPrimary">@color/cuni_green_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/cuni_green_container</item>
        <item name="colorOnPrimaryContainer">@color/cuni_green_primary_dark</item>

        <!-- Secondary Colors -->
        <item name="colorSecondary">@color/cuni_green_secondary</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Background & Surface -->
        <item name="android:colorBackground">@color/cuni_background</item>
        <item name="colorSurface">@color/cuni_surface</item>
        <item name="colorOnSurface">@color/cuni_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/cuni_text_secondary</item>

        <!-- Status Bar White Background with Dark Icons -->
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.CUNIPRO" parent="Base.Theme.CUNIPRO" />
</resources>
